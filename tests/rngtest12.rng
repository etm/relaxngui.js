<element rngui:version="1.2" rngui:header="Arguments" name="arguments" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes" xmlns="http://relaxng.org/ns/structure/1.0" xmlns:rngui="http://rngui.org">
  <element name="behavior" rngui:label="Mode">
    <choice>
      <value>wait_running</value>
      <value>fork_running</value>
    </choice>
  </element>
  <choice rngui:name="purpose" rngui:label="Purpose">
    <element name="url" rngui:label="Model" rngui:choice_label="Process Execution">
      <data type="string" rngui:label="Link to testset"/>
    </element>
    <element name="_url" rngui:header="Models (first one is executed)" rngui:choice_label="Resource Selection">
      <zeroOrMore rngui:label="Add Model">
        <element name="_url_item" rngui:label="Model">
          <data type="string" rngui:label="Link to testset"/>
        </element>
      </zeroOrMore>
    </element>
  </choice>
  <element name="items" rngui:header="Items">
    <zeroOrMore rngui:label="New Item">
      <element name="item">
        <choice rngui:name="kind" rngui:label="Kind">
          <element name="number" rngui:label="Number" rngui:choice_label="A Number">
            <data type="integer" rngui:label="e.g. 42"/>
          </element>
          <element name="text" rngui:label="Text" rngui:choice_label="A Text">
            <data type="string" rngui:label="e.g. hello"/>
          </element>
          <element name="list" rngui:header="List" rngui:choice_label="A List">
            <zeroOrMore rngui:label="New Entry">
              <element name="entry" rngui:label="Entry">
                <data type="string" rngui:label="e.g. x"/>
              </element>
            </zeroOrMore>
          </element>
        </choice>
      </element>
    </zeroOrMore>
  </element>
</element>
